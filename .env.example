# ── Gemini API ─────────────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com/apikey
# Copy this file to .env and fill in your values. Never commit .env to git.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ── SMTP (required only for real email sending) ────────────────────────────
# Leave blank during testing. Emails are previewed in the UI without sending.
# Gmail example: use an App Password, not your main account password.
#   Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SENDER_EMAIL=your_email@gmail.com

# ── Branding ───────────────────────────────────────────────────────────────
COMPANY_NAME=Your Company Name Here
